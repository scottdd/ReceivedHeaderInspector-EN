{
    "manifest_version": 2,
    "name": "__MSG_extName__",
    "description": "__MSG_extDescription__",
    "version": "1.6.0",
    "author": "Olivier P. (original author); English fork by Scott Dowlen",
    "default_locale": "en",
    "browser_specific_settings": {
        "gecko": {
            "id": "receivedheaderinspector-en@dowlen.net",
            "strict_min_version": "128.0"
        }
    },
    "message_display_action": {
        "default_popup": "messagePopup/popup.html",
        "default_title": "__MSG_actionTitle__",
        "default_icon": "images/bouclier-32px.png"
    },
    "permissions": [
        "messagesRead"
    ],
    "icons": {
        "64": "images/bouclier-64px.png",
        "32": "images/bouclier-32px.png",
        "16": "images/bouclier-16px.png"
    }
}
